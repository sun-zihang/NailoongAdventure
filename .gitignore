# ===== Unity 生成/缓存目录（不纳入版本控制）=====
/Library/
/Temp/
/Logs/
/Obj/
/Build/
/Builds/
/MemoryCaptures/
/UserSettings/
/ProjectSettings/ProjectVersionOverride.txt

# Unity 目录监控临时文件
~UnityDirMonSyncFile~*

# ===== 运行时一键生成的资产（打开工程后由「奶龙/一键生成 Demo」重建）=====
# 这些目录由 Editor 脚本重新生成，仓库只保留可复现的源代码。
# 注意：Prefabs / VFX / Audio / Fonts 在 Resources/ 子目录下（见 GameBuilder 路径常量）。
/Assets/NailoongAdventure/Resources/Prefabs/
/Assets/NailoongAdventure/Resources/VFX/
/Assets/NailoongAdventure/Resources/Audio/
/Assets/NailoongAdventure/Resources/Fonts/
/Assets/NailoongAdventure/Scenes/
/Assets/NailoongAdventure/Materials/
/Assets/NailoongAdventure/Meshes/
/Assets/NailoongAdventure/Textures/

# 构建产物
/Builds/

# Web 展示页构建输出（由 Cloudflare Pages 在 CI 中生成，不入库）
/dist/

# ===== IDE / 编辑器 =====
.vs/
.idea/
*.csproj
*.sln
*.unityproj
*.booproj
*.pidb
*.suo
*.user
*.userprefs
*.unitypackage

# ===== OS / 杂项 =====
.DS_Store
Thumbs.db
*.tmp
*.log
~$*
